#!/usr/bin/env zsh

PROMPT="Work on next task in plan.md.
When it is complete, mark it as complete.
Git commit and push after every task,
with a useful message about what has been done and how.
"

cook "$PROMPT" \
  ralph 5 "DONE if all tasks complete, else NEXT" \
  --yes

