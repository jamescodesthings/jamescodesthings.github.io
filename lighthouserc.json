{
  "ci": {
    "collect": {
      "url": ["https://127.0.0.1:8099/", "https://127.0.0.1:8099/blog/2026-05-01-zerocalc.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --ignore-certificate-errors"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median-run",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "categories:performance": ["warn", { "minScore": 0.95 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }]
          }
        },
        {
          "matchingUrlPattern": "^https://127\\.0\\.0\\.1:8099/$",
          "aggregationMethod": "median-run",
          "assertions": {
            "total-byte-weight": ["warn", { "maxNumericValue": 512000 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
