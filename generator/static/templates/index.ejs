<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Language" content="en">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>James Macmillan — CodesThings.com</title>
  <meta name="description" content="Software engineer portfolio — James Macmillan builds things for the web.">

  <link rel="icon" href="assets/icons/favicon-color.svg">
  <link rel="icon" href="assets/icons/favicon-color-228.png" sizes="228x228">
  <link rel="apple-touch-icon" href="assets/icons/favicon-color-228.png" sizes="228x228">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
  <%- include('sections/hero', { name: 'James Macmillan' }) %>
  <%- include('sections/campsnap-banner') %>
  <%- include('sections/cover-letter', { sidebar, coverLetter, profile }) %>
  <%- include('sections/experience', { sidebar, experience, profile }) %>
  <%- include('sections/skills', { sidebar, skills, education }) %>
  <%- include('sections/projects', { sidebar, projects }) %>
  <% if (blogPosts && blogPosts.length > 0) { %>
  <section class="section" data-animate>
    <div class="section-inner">
      <span class="section-label">BLOG</span>
      <h2 class="section-title">Writing</h2>
      <ul class="blog-list">
        <% blogPosts.forEach(function(post) { %>
        <li><a href="blog/<%= post.slug %>.html"><%= post.title %></a></li>
        <% }); %>
      </ul>
    </div>
  </section>
  <% } %>
  <%- include('sections/footer') %>

  <script src="js/theme.js"></script>
</body>
</html>
