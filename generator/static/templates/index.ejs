<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="Content-Language" content="en">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CodesThings.com</title>

  <link rel="icon" href="assets/favicon/favicon-color.svg">
  <link rel="icon" href="assets/favicon/favicon-color-32.png" sizes="32x32">
  <link rel="icon" href="assets/favicon/favicon-color-57.png" sizes="57x57">
  <link rel="icon" href="assets/favicon/favicon-color-76.png" sizes="76x76">
  <link rel="icon" href="assets/favicon/favicon-color-96.png" sizes="96x96">
  <link rel="icon" href="assets/favicon/favicon-color-128.png" sizes="128x128">
  <link rel="icon" href="assets/favicon/favicon-color-192.png" sizes="192x192">
  <link rel="icon" href="assets/favicon/favicon-color-228.png" sizes="228x228">
  <link rel="shortcut icon" sizes="196x196" href="assets/favicon/favicon-color-196.png">
  <link rel="apple-touch-icon" href="assets/favicon/favicon-light-round-120.png" sizes="120x120">
  <link rel="apple-touch-icon" href="assets/favicon/favicon-light-round-152.png" sizes="152x152">
  <link rel="apple-touch-icon" href="assets/favicon/favicon-light-round-180.png" sizes="180x180">

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@v2.15.1/devicon.min.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body>
  <%- include('sections/hero', { name: 'James Macmillan' }) %>
  <%- include('sections/campsnap-banner') %>
  <%- include('sections/cover-letter', { sidebar, coverLetter, profile }) %>
  <%- include('sections/experience', { sidebar, experience, profile }) %>
  <%- include('sections/skills', { sidebar, skills, education }) %>
  <%- include('sections/projects', { sidebar, projects }) %>
  <% if (blogPosts && blogPosts.length > 0) { %>
  <section class="paper-page">
    <div class="blog-links">
      <h3>Blog</h3>
      <ul>
        <% blogPosts.forEach(function(post) { %>
        <li><a href="blog/<%= post.slug %>.html"><%= post.title %></a></li>
        <% }); %>
      </ul>
    </div>
  </section>
  <% } %>
  <%- include('sections/footer') %>

  <script src="js/theme.js"></script>
</body>
</html>
