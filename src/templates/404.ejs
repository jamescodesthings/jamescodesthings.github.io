<!DOCTYPE html>
<%- include('sections/banner') -%>
<html lang="en">
  <head>
    <%- include('sections/head') %>
  </head>
  <body class="page-404">
    <%- include('sections/header') %>
    <main id="main">
      <div class="container segfault">
        <p class="segfault__code" aria-hidden="true">404</p>
        <h1 class="segfault__title">Segmentation fault (page dumped)</h1>
        <pre class="segfault__trace" aria-label="Stack trace"><code>at resolve(<span id="segfault-path">/this/page</span>)
at <span class="segfault__muted" id="segfault-path-2">/this/page</span> (location.pathname:1:1)
at Object.&lt;anonymous&gt; (404.html:1:1)</code></pre>
        <ul class="segfault__links">
          <li><a class="btn btn--primary" href="/">Home</a></li>
          <li><a class="btn btn--secondary" href="/cv/">CV</a></li>
          <li><a class="btn btn--secondary" href="/blog/">Blog</a></li>
        </ul>
      </div>
    </main>
    <%- include('sections/footer') %>
    <script>
      (function () {
        ['segfault-path', 'segfault-path-2'].forEach(function (id) {
          var el = document.getElementById(id);
          if (el) el.textContent = location.pathname;
        });
      })();
    </script>
    <script type="module" src="/js/main.js"></script>
  </body>
</html>
