<%
  // locals: site, now, links, projects ({work[], make[]}), photos[], blogPosts[], formatDate, stamp.
  const featured = list => list.filter(p => p.featured);
  const cv = links.find(l => l.primary);
  const instagram = links.find(l => l.name === 'Instagram');
  const proof = site.proof.map(item => ({
    ...item,
    solo: item.label.toLowerCase().includes(item.value.toLowerCase()),
  }));
  const latest = blogPosts.slice(0, 5);
  const railSections = [
    { id: 'top', icon: 'home', title: 'Top', num: '01' },
    { id: 'currently', icon: 'pulse', title: 'Currently', num: '02' },
    { id: 'work', icon: 'terminal', title: 'Work', num: '03' },
    { id: 'make', icon: 'cube', title: 'Make', num: '04' },
    { id: 'photos', icon: 'aperture', title: 'Photos', num: '05' },
    ...(latest.length > 0 ? [{ id: 'blog', icon: 'pen', title: 'Blog', num: '06' }] : []),
  ];
-%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('sections/head') %>
  </head>
  <body class="page-home">
    <%- include('sections/header') %>
    <main id="main">
      <%- include('sections/hero', { site, links }) %>

      <section id="currently" class="home-section" aria-labelledby="currently-title" data-rail-icon="pulse" data-rail-title="Currently">
        <div class="container">
          <%- include('sections/section-head', { id: 'currently', num: '02', icon: 'pulse', title: 'Currently' }) %>
          <ul class="currently-list">
            <% now.items.forEach(function (item) { %><li><%= item %></li><% }); %>
          </ul>
          <p class="section-meta">
            <span>Updated <time datetime="<%= now.updated %>"><%= formatDate(now.updated) %></time></span>
            <a class="text-link" href="/now"><span>More on /now</span><%- include('sections/icon', { name: 'arrow', size: 18 }) %></a>
          </p>
        </div>
      </section>

      <section id="work" class="home-section" aria-labelledby="work-title" data-rail-icon="terminal" data-rail-title="Work">
        <div class="container">
          <%- include('sections/section-head', { id: 'work', num: '03', icon: 'terminal', title: 'Work' }) %>
          <p class="section-lede"><%= site.careerSummary %></p>
          <% if (proof.length) { %>
          <ul class="proof">
            <% proof.forEach(function (item) { %>
            <li class="proof__item">
              <% if (!item.solo) { %><span class="proof__value"><%= item.value %></span><% } %>
              <span class="proof__label<%= item.solo ? ' proof__label--solo' : '' %>"><%= item.label %></span>
            </li>
            <% }); %>
          </ul>
          <% } %>
          <div class="card-grid-wrap">
            <ul class="card-grid">
              <% featured(projects.work).forEach(function (project, i) { %>
              <li<%- i === 0 ? ' class="card-grid__wide"' : '' %>><%- include('sections/project-card', { project, wide: i === 0 }) %></li>
              <% }); %>
            </ul>
          </div>
          <p class="section-actions">
            <% if (cv) { %><a class="text-link" href="<%= cv.url %>"><span>Read the full CV</span><%- include('sections/icon', { name: 'arrow', size: 18 }) %></a><% } %>
            <a class="text-link" href="/projects/"><span>All projects</span><%- include('sections/icon', { name: 'arrow', size: 18 }) %></a>
          </p>
        </div>
      </section>

      <section id="make" class="home-section" aria-labelledby="make-title" data-rail-icon="cube" data-rail-title="Make">
        <div class="container">
          <%- include('sections/section-head', { id: 'make', num: '04', icon: 'cube', title: 'Make' }) %>
          <div class="card-grid-wrap">
            <ul class="card-grid">
              <% featured(projects.make).forEach(function (project, i) { %>
              <li<%- i === 0 ? ' class="card-grid__wide"' : '' %>><%- include('sections/project-card', { project, wide: i === 0 }) %></li>
              <% }); %>
            </ul>
          </div>
          <p class="section-actions">
            <a class="text-link" href="/projects/#make"><span>All maker projects</span><%- include('sections/icon', { name: 'arrow', size: 18 }) %></a>
          </p>
        </div>
      </section>

      <section id="photos" class="home-section" aria-labelledby="photos-title" data-rail-icon="aperture" data-rail-title="Photos">
        <div class="container">
          <%- include('sections/section-head', { id: 'photos', num: '05', icon: 'aperture', title: 'Photos' }) %>
          <%- include('sections/campsnap-banner') %>
          <% if (photos.length) { %>
          <ul class="photo-strip">
            <% photos.slice(0, 8).forEach(function (photo) {
              const exif = photo.exif ? [photo.exif.camera, photo.exif.lens, photo.exif.focal, photo.exif.aperture, photo.exif.shutter, photo.exif.iso && 'ISO ' + photo.exif.iso].filter(Boolean).join(' · ') : ''; %>
            <li>
              <figure class="photo" tabindex="0">
                <%- include('sections/picture', { image: photo.imageData, alt: photo.alt, sizes: '(min-width: 48rem) 25vw, 60vw', priority: false }) %>
                <% if (photo.caption || exif) { %>
                <figcaption class="photo__caption">
                  <% if (photo.caption) { %><span><%= photo.caption %></span><% } %>
                  <% if (exif) { %><span class="photo__exif"><%= exif %></span><% } %>
                </figcaption>
                <% } %>
              </figure>
            </li>
            <% }); %>
          </ul>
          <% } else if (instagram) { %>
          <a class="insta-card" href="<%= instagram.url %>" target="_blank" rel="noopener noreferrer">
            <%- include('sections/icon', { name: 'instagram', size: 28 }) %>
            <span class="insta-card__text">
              <strong>Photos live on Instagram for now</strong>
              <span>Follow along at @jamescodesthings<span class="visually-hidden"> (opens in a new tab)</span></span>
            </span>
            <%- include('sections/icon', { name: 'external', size: 18 }) %>
          </a>
          <% } %>
        </div>
      </section>

      <% if (latest.length > 0) { %>
      <section id="blog" class="home-section" aria-labelledby="blog-title" data-rail-icon="pen" data-rail-title="Blog">
        <div class="container">
          <%- include('sections/section-head', { id: 'blog', num: '06', icon: 'pen', title: 'Blog' }) %>
          <ul class="blog-list">
            <% latest.forEach(function (post) { %>
            <li class="blog-list__item">
              <a class="blog-list__link" href="/blog/<%= post.slug %>.html"><%= post.title %></a>
              <% if (post.summary) { %><p class="blog-list__summary"><%= post.summary %></p><% } %>
              <% if (post.date) { %><time class="blog-list__date" datetime="<%= post.date %>"><%= formatDate(post.date) %></time><% } %>
            </li>
            <% }); %>
          </ul>
          <p class="section-actions">
            <a class="text-link" href="/blog/"><span>All posts</span><%- include('sections/icon', { name: 'arrow', size: 18 }) %></a>
            <a class="text-link" href="/feed.xml"><%- include('sections/icon', { name: 'rss', size: 18 }) %><span>RSS</span></a>
          </p>
        </div>
      </section>
      <% } %>
    </main>
    <%- include('sections/rail', { railSections }) %>
    <%- include('sections/campsnap-fab') %>
    <%- include('sections/footer') %>
    <script type="module" src="/js/main.js"></script>
  </body>
</html>
