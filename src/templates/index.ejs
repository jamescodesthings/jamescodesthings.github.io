<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('sections/head') %>
  </head>
  <body>
    <%- include('sections/header') %>
    <main id="main">
      <%- include('sections/hero', { name: 'James Macmillan', links }) %>
      <%- include('sections/campsnap-banner') %>
      <% if (blogPosts && blogPosts.length > 0) { %>
      <section class="section">
        <div class="section-inner">
          <span class="section-label">01 - LATEST</span>
          <h2 class="section-title">Blog</h2>
          <ul class="blog-list">
            <% blogPosts.forEach(function(post) { %>
            <li class="blog-list-item">
              <a href="/blog/<%= post.slug %>.html" class="blog-list-link">
                <span class="blog-list-title"><%= post.title %></span>
                <%- include('sections/icon', { name: 'arrow', size: 18, className: 'blog-list-arrow' }) %>
              </a>
              <% if (post.summary) { %><p class="blog-list-summary"><%= post.summary %></p><% } %>
              <% if (post.date) { %><time class="blog-list-date" datetime="<%= post.date %>"><%= formatDate(post.date) %></time><% } %>
            </li>
            <% }); %>
          </ul>
        </div>
      </section>
      <% } %>
    </main>
    <%- include('sections/campsnap-fab') %>
    <%- include('sections/footer') %>
    <script src="/js/fab.js"></script>
    <script type="module" src="/js/main.js"></script>
  </body>
</html>
