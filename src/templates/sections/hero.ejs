<section class="hero">
  <div class="hero-inner">
    <div class="hero-content">
      <h1 class="hero-title uppercase"><%= name %></h1>
      <p class="hero-role">SoFtWaRe EnGiNeEr</p>
      <nav class="hero-links" aria-label="Links">
        <ul class="hero-links-list">
          <% links.forEach(function(link) { %>
          <li>
            <a
              href="<%= link.url %>"
              class="<%= link.primary ? 'hero-cta' : 'hero-link' %>"
              <% if (!link.primary) { %>target="_blank" rel="noopener noreferrer"<% } %>
            >
              <%- include('icon', { name: link.icon, size: link.primary ? 18 : 20 }) %>
              <span><%= link.label %></span>
            </a>
          </li>
          <% }); %>
        </ul>
      </nav>
    </div>
  </div>
</section>
