<%
  // The CampSnap spotlight inside Photos. Video: preload none, autoplay only when motion is allowed (video.js).
-%>
<div class="spotlight" data-video-scope>
  <div class="spotlight__text">
    <h3 class="spotlight__title">I feel like you're just here for the campsnap filters</h3>
    <a class="text-link" href="/campsnap"><span>codesthings.com/campsnap</span><%- include('icon', { name: 'arrow', size: 18 }) %></a>
  </div>
  <div class="spotlight__media">
    <video class="spotlight__video" muted loop playsinline preload="none" poster="/assets/zipline-poster.jpg" width="640" height="480" aria-label="CampSnap filter demo on a zipline" data-autoplay>
      <source src="/assets/zipline.mp4" type="video/mp4" />
    </video>
    <button type="button" class="video-toggle" data-video-toggle>Pause video</button>
  </div>
</div>
