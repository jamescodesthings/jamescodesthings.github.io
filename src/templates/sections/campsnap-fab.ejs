<%
  // Floating CampSnap button. Behaviour in fab.js. Size and offset come from --fab-size and --fab-offset (fab.css).
-%>
<div class="campsnap-fab" id="campsnapFab" data-video-scope>
  <div class="campsnap-fab-popover" id="campsnapPopover" role="group" aria-label="CampSnap filters" hidden>
    <button type="button" class="campsnap-fab-close" id="campsnapClose" aria-label="Close"><%- include('icon', { name: 'close', size: 18 }) %></button>
    <div class="video-frame">
      <video class="campsnap-fab-video" muted loop playsinline preload="none" poster="/assets/zipline-poster.jpg" width="640" height="480" aria-label="CampSnap filter demo on a zipline">
        <source src="/assets/zipline.mp4" type="video/mp4" />
      </video>
      <button type="button" class="video-toggle" data-video-toggle aria-label="Play video"><%- include('icon', { name: 'play', size: 28 }) %></button>
    </div>
    <p class="campsnap-fab-caption">I feel like you're just here for the campsnap filters.</p>
    <a href="/#project-campsnap-filters" class="campsnap-fab-link"><span>Get the filters</span><%- include('icon', { name: 'arrow', size: 16 }) %></a>
  </div>
  <button type="button" class="campsnap-fab-btn" id="campsnapFabBtn" aria-label="CampSnap filters" aria-expanded="false" aria-controls="campsnapPopover">
    <%# A CampSnap drawn like the other icons: 24 units, stroked in currentColor. %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="2" y="5" width="20" height="14" rx="2" />
      <path d="M2 9.5h20" />
      <circle cx="11.5" cy="13.5" r="3.5" />
      <rect x="17" y="6.5" width="3" height="1.5" rx="0.5" />
    </svg>
  </button>
</div>
