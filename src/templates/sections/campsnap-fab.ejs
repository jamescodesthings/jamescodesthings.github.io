<%
  // Floating CampSnap button. Behaviour in fab.js. Size and offset come from --fab-size and --fab-offset (fab.css).
-%>
<div class="campsnap-fab" id="campsnapFab" data-video-scope>
  <div class="campsnap-fab-popover" id="campsnapPopover" role="group" aria-label="CampSnap filters" hidden>
    <button type="button" class="campsnap-fab-close" id="campsnapClose" aria-label="Close"><%- include('icon', { name: 'close', size: 18 }) %></button>
    <video class="campsnap-fab-video" muted loop playsinline preload="none" poster="/assets/zipline-poster.jpg" width="640" height="480" aria-label="CampSnap filter demo on a zipline">
      <source src="/assets/zipline.mp4" type="video/mp4" />
    </video>
    <button type="button" class="video-toggle" data-video-toggle>Pause video</button>
    <p class="campsnap-fab-caption">I feel like you're just here for the campsnap filters.</p>
    <a href="/campsnap" class="campsnap-fab-link"><span>Get the filters</span><%- include('icon', { name: 'arrow', size: 16 }) %></a>
  </div>
  <button type="button" class="campsnap-fab-btn" id="campsnapFabBtn" aria-label="CampSnap filters" aria-expanded="false" aria-controls="campsnapPopover">
    <svg id="Campsnap" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="30" height="30" fill="currentColor" aria-hidden="true" focusable="false">
      <rect x="0" y="96.78" width="512" height="318.44" rx="12" ry="12" />
      <rect class="campsnap-fab-accent" x="26.99" y="125.98" width="458.02" height="108.48" />
      <circle cx="262.1" cy="268.31" r="108.48" />
      <circle class="campsnap-fab-accent" cx="262.1" cy="268.31" r="84.37" />
      <circle cx="262.1" cy="268.31" r="60.27" />
      <rect x="378.88" y="145.23" width="87.41" height="69.98" rx="6" ry="6" />
      <circle class="campsnap-fab-accent" cx="232.23" cy="249.58" r="11.68" />
      <circle class="campsnap-fab-accent" cx="249.93" cy="234.46" r="6.03" />
      <circle class="campsnap-fab-accent" cx="394.6" cy="167.27" r="7.15" />
      <circle class="campsnap-fab-accent" cx="405.45" cy="158.01" r="3.69" />
    </svg>
  </button>
</div>
