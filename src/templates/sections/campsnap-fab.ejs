<div class="campsnap-fab" id="campsnapFab">
  <div class="campsnap-fab-popover" id="campsnapPopover" aria-hidden="true">
    <button class="campsnap-fab-close" id="campsnapClose" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <video class="campsnap-fab-video" autoplay loop muted playsinline>
      <source src="assets/zipline.webm" type="video/webm" />
      <source src="assets/zipline.mp4" type="video/mp4" />
    </video>
    <p class="campsnap-fab-caption">I feel like you're just here for the campsnap filters.</p>
    <a href="https://codesthings.com/campsnap" class="campsnap-fab-link">
      Get the filters
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </div>
  <button class="campsnap-fab-btn" id="campsnapFabBtn" aria-label="Campsnap filters" aria-expanded="false">
    <svg class="campsnap-fab-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      <path d="M20 3v4"/>
      <path d="M22 5h-4"/>
    </svg>
    <span class="campsnap-fab-label">campsnap</span>
  </button>
</div>
