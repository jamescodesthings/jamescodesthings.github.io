<%
  // locals: project (validated data/projects entry), wide (bool; spans two columns when the grid has three).
  const isWide = typeof wide !== 'undefined' && wide;
  // The id lets a link point at the card (/#project-campsnap-filters); seek.js lights it on arrival.
  const id = 'project-' + project.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  // A primary link is the card's one action: its ::after covers the whole card, so a tap anywhere goes there.
  const linked = project.links.some(link => link.primary);
-%>
<article id="<%= id %>" class="project-card<%= isWide ? ' project-card--wide' : '' %><%= linked ? ' project-card--linked' : '' %>">
  <div class="project-card__media">
    <% if (project.imageData) { %>
    <%- include('picture', { image: project.imageData, alt: '', sizes: isWide ? '(min-width: 64rem) 45vw, 100vw' : '(min-width: 64rem) 33vw, (min-width: 40rem) 50vw, 100vw', priority: false }) %>
    <% } else if (project.art) { %>
    <div class="project-card__art" aria-hidden="true"><%- include('../art/' + project.art) %></div>
    <% } else { %>
    <div class="project-card__placeholder" aria-hidden="true"><%- include('icon', { name: project.lane === 'make' ? 'cube' : 'terminal', size: 72 }) %></div>
    <% } %>
  </div>
  <div class="project-card__body">
    <h3 class="project-card__title"><%= project.title %></h3>
    <p class="project-card__summary"><%= project.summary %></p>
    <% if (project.stat) { %><p class="project-card__stat"><%= project.stat %></p><% } %>
    <% if (project.stack.length) { %>
    <ul class="tags" aria-label="Stack">
      <% project.stack.forEach(function (item) { %><li class="tags__item"><%= item %></li><% }); %>
    </ul>
    <% } %>
    <% if (project.links.length) { %>
    <ul class="project-card__links">
      <% project.links.forEach(function (link) {
        const external = /^https?:/.test(link.url); %>
      <li>
        <a class="project-link<%= link.primary ? ' project-link--primary' : '' %>" href="<%= link.url %>"<% if (external) { %> target="_blank" rel="noopener noreferrer"<% } %>>
          <%- include('icon', { name: link.icon, size: 18 }) %><span><%= link.label %></span><span class="visually-hidden"> for <%= project.title %><%= external ? ' (opens in a new tab)' : '' %></span><% if (link.primary) { %><%- include('icon', { name: 'arrow', size: 16 }) %><% } %>
        </a>
      </li>
      <% }); %>
    </ul>
    <% } %>
  </div>
</article>
