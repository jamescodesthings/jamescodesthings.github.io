<%
  // Thin-line 24px icons, drawn in currentColor. The drawings live in shared/icons (vendored from the resources repo).
  const iconSize = typeof size === 'undefined' ? 20 : size;
%><svg
  class="icon <%= typeof className === 'undefined' ? '' : className %>"
  width="<%= iconSize %>"
  height="<%= iconSize %>"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
><%- iconInner(name) %></svg>
