{
  "name": "codesthings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --no-deprecation ./src/index.js",
    "watch": "node --no-deprecation ./src/watch.js",
    "server": "node --no-deprecation ./src/server.js",
    "test": "node --test test/",
    "format": "prettier .",
    "format:check": "npm run format -- --check",
    "format:fix": "npm run format -- --write",
    "contrast": "node scripts/contrast.js",
    "lighthouse": "node scripts/lighthouse.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "debug": "^4.4.3",
    "ejs": "^6.0.1",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^10.0.0",
    "satori": "^0.44.3",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "prettier": "3.8.4"
  }
}
