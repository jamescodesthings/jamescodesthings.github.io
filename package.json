{
  "name": "codesthings",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --no-deprecation ./src/index.js",
    "watch": "node --no-deprecation ./src/watch.js",
    "server": "node --no-deprecation ./src/server.js",
    "test": "node --test test/",
    "format": "prettier .",
    "format:check": "npm run format -- --check",
    "format:fix": "npm run format -- --write"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "ejs": "^6.0.1",
    "lightningcss": "^1.33.0",
    "showdown": "^2.1.0"
  },
  "devDependencies": {
    "prettier": "3.8.4"
  }
}
